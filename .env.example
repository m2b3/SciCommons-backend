# Safe local-development defaults. Never put production credentials here.
DEBUG=True
SECRET_KEY=local-development-only-secret-key-change-me-0123456789
ENVIRONMENT=local
FRONTEND_URL=http://localhost:3000

# Local SMTP placeholder. Email delivery is unavailable unless you run a
# development SMTP server or replace these values in your ignored .env.local.
EMAIL_HOST=host.docker.internal
EMAIL_HOST_USER=local
EMAIL_HOST_PASSWORD=local
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=local@scicommons.invalid

# Object-storage placeholders allow Django to start without production
# credentials. Supply a personal/sandbox S3 service to test uploads.
AWS_ACCESS_KEY_ID=local-only
AWS_SECRET_ACCESS_KEY=local-only
AWS_STORAGE_BUCKET_NAME=scicommons-local
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=https://object-storage.invalid
AWS_S3_CUSTOM_DOMAIN=object-storage.invalid/scicommons-local
AWS_DEFAULT_ACL=public-read
AWS_QUERYSTRING_AUTH=False

# Local PostgreSQL service from docker-compose.dev.yml
DB_NAME=scicommons_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Local Redis, Celery, and realtime services
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_HOST_URL=redis://redis:6379/1
REALTIME_REDIS_URL=redis://redis:6379/3
TORNADO_URL=http://tornado:8888
TORNADO_PORT=8888
QUEUE_TTL_MINUTES=2
MAX_EVENTS_PER_QUEUE=1000
POLL_TIMEOUT_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=60
